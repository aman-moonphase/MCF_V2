POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mcf_db
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/mcf_db

FRONTEND_URL=http://localhost:3000

# development | test | demo | staging | production
ENV=development

# JWT signing secret. REQUIRED outside development (the app refuses to start without it).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# AI provider: demo (no key needed) | openai | claude
AI_PROVIDER=demo

# OpenAI (when AI_PROVIDER=openai)
OPENAI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini

# Claude / Anthropic (when AI_PROVIDER=claude). Backend only — never expose to the frontend.
ANTHROPIC_API_KEY=
# Claude API model ID, used exactly as written. Default: claude-sonnet-5-5 (the latest Sonnet).
# Set an Opus ID (e.g. claude-opus-5-5) only when you explicitly want Opus. Current IDs:
# https://platform.claude.com/docs/en/about-claude/models/overview
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=16000
CLAUDE_EFFORT=medium

# Embeddings for RAG: demo | openai (Claude has no embeddings API). Defaults to openai only when AI_PROVIDER=openai.
EMBEDDING_PROVIDER=

# Characters of source text placed directly in each prompt (full text stays stored and searchable).
AI_MAX_SOURCE_CHARS=60000

# Email settings for password resets (e.g. for Gmail or SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
